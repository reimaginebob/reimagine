# Reimagine local-dev env vars. Copy this file to .env.local and fill in
# the real values. .env.local is gitignored and never committed.
#
# Production values live in the Vercel project settings, not here.

# Neon Postgres (pooled connection string)
DATABASE_URL=

# Resend API key + verified sender. Sender must match a verified domain
# in the Resend dashboard. Example: "Reimagine <hi@send.career.club>".
RESEND_API_KEY=
EMAIL_FROM=

# Base URL the magic-link email points back to. For local dev with
# `vercel dev`, this is usually http://localhost:3000.
MAGIC_LINK_BASE_URL=

# Session cookie config
SESSION_COOKIE_NAME=pe_session
SESSION_DAYS=30

# Vercel Protection Bypass for Automation token (project setting).
# Used by scripts/smoke-preview.mjs to curl preview deployments past
# Vercel's deployment protection. Generate at:
#   Vercel project settings → Deployment Protection →
#   Protection Bypass for Automation.
# At deploy time the same token is exposed as VERCEL_AUTOMATION_BYPASS_SECRET.
# Rotate via the same Vercel setting if leaked.
VERCEL_PROTECTION_BYPASS=

# Admin dashboard access (finding #2.8, 2026-09-08 prelaunch audit). No
# credential to generate or rotate any more: access is the signed-in session
# cookie (the same one the product uses) checked against an email allowlist.
# Comma-separated, case-insensitive. Two levels:
#
# ADMIN_LOGIN_EMAILS unlocks every admin endpoint, including the ones that
# change state (suspending an account, granting beta access, recording who is
# paying). Keep it to the owner. Deliberately NOT the same variable as
# ADMIN_EMAILS below -- that one means something else entirely (an
# analytics-exclusion + ops-alert-recipient list).
#
# ANALYST_LOGIN_EMAILS is read-only and optional. It opens exactly four GET
# endpoints -- /api/admin/user-stages, /api/admin/growth, /api/admin/dormant,
# /api/admin/generation-attempts -- so a collaborator can pull the data those
# serve without being handed the ability to suspend a user. Never accepted on
# a write path; see api/_lib/admin-auth.js. Leave unset if nobody has been
# granted analyst access.
ADMIN_LOGIN_EMAILS=
ANALYST_LOGIN_EMAILS=

# ADMIN_TOKEN survives as a legacy secret for exactly two manual, curl-only
# ops paths with no browser UI or dashboard button: api/admin/stage-snapshot.js's
# manual-trigger escape hatch and api/oauth/revoke.js. Neither was ever
# exposed to the vulnerability the audit named (the dashboard's own
# localStorage, reachable by any XSS in the React app), so neither moved to
# the session model above. Leave unset if these are only ever triggered by
# their own crons / support workflow doesn't need the manual path.
# Generate with:  openssl rand -base64 32
ADMIN_TOKEN=

# Anthropic API key for every generation surface.
ANTHROPIC_API_KEY=

# Monthly Anthropic spend budget, in whole dollars (e.g. 500). Set this to the
# same monthly limit configured on the Anthropic account.
#
# This is what the hourly watchdog measures spend against. Anthropic does not
# expose the account's spend cap over the API, so the number has to be kept in
# step by hand -- if you change the limit in the Anthropic console, change it
# here too and redeploy production (env is injected at build time).
#
# Leave it unset and nothing warns you before the cap is reached; that was the
# 2026-08-15 failure, where generation stopped app-wide and the first anyone
# knew of it was users reading the raw upstream error. With it set, the
# watchdog emails ADMIN_EMAILS at 50%, 75%, 90% and 100% of the month, and
# separately the first time the burn rate projects a month that ends over it.
ANTHROPIC_MONTHLY_BUDGET_USD=

# Where operator alerts go: watchdog trips, budget warnings, and the page that
# fires when Anthropic starts refusing calls. Comma-separated. With this empty,
# the conditions are still detected and logged, but nobody is told.
ADMIN_EMAILS=

# Shared secret on the Vercel cron requests (Authorization: Bearer <secret>).
CRON_SECRET=

# Signing secret for api/webhooks/stripe.js, which ingests direct Career
# Club donations into the `donations` table. This is the `whsec_...` value
# Stripe shows when the webhook endpoint is created (Dashboard → Developers
# → Webhooks → Add endpoint, URL https://reimagine.career.club/api/webhooks/stripe,
# events checkout.session.completed + invoice.payment_succeeded), on the
# career.club Stripe account (acct_1IQLNEK4uJoqzRSd). No Stripe SECRET key
# is needed anywhere in this repo -- donations are captured entirely from
# the webhook payload, never by calling the Stripe API.
STRIPE_WEBHOOK_SECRET=

# PayPal Commerce Platform -- the PayPal/Venmo/card option on the same Pay
# It Forward panel, alongside (not replacing) the Stripe links above. See
# Output/handoff/2026-09-17_paypal-commerce-integration.md.
#
# One set of names, not two -- which API PayPal treats this as (Sandbox vs
# Live) is decided by Vercel's environment (VERCEL_ENV), not by which
# suffixed var is set: Preview holds the Sandbox app's values, Production
# holds the Live app's. Same scoping model CLAUDE.md documents for
# ADMIN_LOGIN_EMAILS -- set both environments in Vercel, and remember a
# value change only reaches an already-built deployment after a redeploy.
#
# From the PayPal Developer Dashboard app (Sandbox while testing, Live once
# promoted):
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The webhook's own id (not the secret) -- shown on the webhook's detail
# page once created. Verified per-request against PayPal's own
# /v1/notifications/verify-webhook-signature endpoint; see the header
# comment in api/webhooks/paypal.js for why this repo doesn't verify PayPal
# webhooks locally the way it does Stripe's and Resend's.
PAYPAL_WEBHOOK_ID=

# Same Client ID as PAYPAL_CLIENT_ID above, duplicated under the VITE_
# prefix so Vite exposes it to the browser bundle (src/PayPalDonate.jsx
# needs it client-side to load the PayPal JS SDK script tag). A Client ID
# is meant to be public -- it is never paired with the secret in the
# browser -- so this is not a second secret to protect, just Vite's own
# mechanism for deciding which env vars ship to the client.
VITE_PAYPAL_CLIENT_ID=
